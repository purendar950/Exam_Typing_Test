rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Admin = has a document in /admins/{uid} (create it manually in the console).
    // Never trust users/{uid}.isAdmin: users can edit their own profile.
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Dedicated machine account (notifier@upp-typing.web.app) used by the GitHub
    // Actions payment-alert job. It can ONLY list pending payment submissions,
    // stamp them as alerted, read the Telegram bot settings, and list support
    // chats with an unread message (stamping those as alerted). No admin rights.
    function isPaymentNotifier() {
      return signedIn() && request.auth.uid == 'ywDOc6gPKAOzxPE4dsLgABLngpH3';
    }

    // Fields a candidate must never set on their own profile.
    function protectedKeys() {
      return ['isAdmin', 'role', 'is_subscribed', 'subscriptionPlan', 'subscriptionPlanName',
              'subscriptionStatus', 'subscriptionPlanType',
              'subscriptionExpiresAt', 'subscriptionExamId', 'subscriptionExamTitle',
              'subscriptionExamSlug', 'subscriptionCategoryGroup',
              'subscriptionApprovedAt'];
    }

    // Current server time as 'YYYY-MM-DDTHH:MM:SS' (UTC). subscriptionExpiresAt is stored
    // as a UTC ISO string, so the two compare correctly as plain strings.
    function pad2(n) { return n < 10 ? '0' + string(n) : string(n); }
    function nowIso() {
      return string(request.time.year()) + '-' + pad2(request.time.month()) + '-' + pad2(request.time.day())
        + 'T' + pad2(request.time.hours()) + ':' + pad2(request.time.minutes()) + ':' + pad2(request.time.seconds());
    }

    // Subscribed AND not expired. A missing expiry date is treated as expired.
    function subscriptionActive(u) {
      return u.get('is_subscribed', false) == true
        && u.get('subscriptionExpiresAt', '') is string
        && u.get('subscriptionExpiresAt', '') > nowIso();
    }

    // Does the plan cover this passage?
    //  - all_exams_pass: everything
    //  - category_combo: passages of the purchased category group
    //  - single_exam: passages tagged with the purchased exam, plus the untagged
    //    passages shared by every exam in the same category group
    function passageInPlan(u, p) {
      return u.get('subscriptionPlanType', '') == 'all_exams_pass'
        || (u.get('subscriptionPlanType', '') == 'category_combo'
            && p.get('categoryGroup', '') != ''
            && p.get('categoryGroup', '') == u.get('subscriptionExamId', ''))
        || (u.get('subscriptionPlanType', '') == 'single_exam'
            && (
              (p.get('examSlug', '') != ''
                && p.get('examSlug', '') == u.get('subscriptionExamSlug', ''))
              || (p.get('examSlug', '') == ''
                && p.get('categoryGroup', '') != ''
                && p.get('categoryGroup', '') == u.get('subscriptionCategoryGroup', ''))
            ));
    }

    function canReadPaidPassage(u, p) {
      return subscriptionActive(u) && passageInPlan(u, p);
    }

    function validUserChatMessage(message) {
      return message is map
        && message.keys().hasOnly(['id', 'sender', 'senderName', 'text', 'timestamp'])
        && message.sender == 'user'
        && message.id is string
        && message.senderName is string
        && message.text is string
        && message.timestamp is string
        && message.text.size() > 0
        && message.text.size() <= 2000;
    }

    // ── Candidate profiles + typing history ──────────────────
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
        && (!('role' in request.resource.data) || request.resource.data.role == 'candidate')
        && (!('is_subscribed' in request.resource.data) || request.resource.data.is_subscribed == false);

      allow update: if isAdmin()
        || (isOwner(userId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedKeys()));

      allow delete: if isAdmin();

      match /test_attempts/{testId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ── Admin accounts ───────────────────────────────────────
    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list, write: if isAdmin();

      match /system_settings/{docId} {
        allow read, write: if isAdmin();
      }
    }

    // ── App settings ─────────────────────────────────────────
    // telegram_config (bot token) and ai_config (API key) are admin-only.
    // pricing_config (plans, promo codes, UPI ID) is shown on the checkout page, so it is public.
    // The payment notifier may read the Telegram settings because it sends the alerts.
    match /system_settings/{docId} {
      allow read: if docId == 'exam_config' || docId == 'pricing_config' || isAdmin()
        || (isPaymentNotifier() && docId == 'telegram_config');
      allow write: if isAdmin();
    }

    // ── Payments ─────────────────────────────────────────────
    // Abuse protection: a UTR number can only be claimed once across ALL
    // accounts (utr_claims), and a candidate can have only one payment
    // awaiting review at a time (payment_pending). Both marker documents are
    // created in the same atomic batch as the submission.
    match /payment_submissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.utrNumber is string
        && request.resource.data.utrNumber.trim().size() >= 6
        && !exists(/databases/$(database)/documents/utr_claims/$(request.resource.data.utrNumber.trim().toUpperCase()))
        && !exists(/databases/$(database)/documents/payment_pending/$(request.auth.uid));
      allow get: if isAdmin() || isPaymentNotifier()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin()
        || (isPaymentNotifier() && resource.data.status == 'pending')
        || (signedIn() && resource.data.userId == request.auth.uid);
      // The notifier may only stamp 'alertedAt' so the alert job knows a
      // submission has already been sent to Telegram.
      allow update: if isAdmin()
        || (isPaymentNotifier()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alertedAt']));
      allow delete: if isAdmin();
    }

    // One claim per UTR number. The document id IS the normalized UTR, so a
    // second claim for the same number can never be created.
    match /utr_claims/{claimId} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if signedIn()
        && claimId == request.resource.data.utrNormalized
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'submissionId', 'utrNormalized', 'createdAt']);
      allow update: if false;
      // Admins delete the claim when rejecting a payment so the student can
      // correct a mistake and submit the same UTR again.
      allow delete: if isAdmin();
    }

    // Rate limit: only one pending payment per candidate. The document id is
    // the candidate's uid; admins delete it when approving or rejecting.
    match /payment_pending/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['userId', 'submissionId', 'createdAt'])
        && request.resource.data.userId == userId
        && request.resource.data.submissionId is string;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Live support chat (candidate <-> admin) ─────────────
    // A candidate can access only the chat attached to their Firebase UID.
    // Do not rely on a random session ID as an authorization control.
    match /support_chats/{chatId} {
      allow get: if isAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin()
        || (isPaymentNotifier() && resource.data.unreadByAdmin == true);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == chatId
        && request.resource.data.keys().hasOnly(
          ['id','userId','userName','userEmail','status','lastMessage','lastMessageAt',
           'unreadByAdmin','unreadByUser','messages','createdAt'])
        && request.resource.data.messages is list
        && request.resource.data.messages.size() == 0
        && request.resource.data.status == 'open';
      // Candidates may append one message at a time. They cannot alter the owner,
      // identity, status, creation time, or existing chat history.
      allow update: if isAdmin() ||
        (isPaymentNotifier()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alertedMessageAt'])) ||
        (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                ['messages','lastMessage','lastMessageAt','unreadByAdmin'])
              && request.resource.data.messages is list
              && request.resource.data.messages.size() == resource.data.messages.size() + 1
              && request.resource.data.messages.hasAll(resource.data.messages)
              && request.resource.data.messages.size() <= 500
              && validUserChatMessage(
                request.resource.data.messages[resource.data.messages.size()]
              )
              && request.resource.data.lastMessage ==
                request.resource.data.messages[resource.data.messages.size()].text
              && request.resource.data.lastMessageAt ==
                request.resource.data.messages[resource.data.messages.size()].timestamp
              && request.resource.data.unreadByAdmin == true
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadByUser'])
              && resource.data.unreadByUser == true
              && request.resource.data.unreadByUser == false
            )
          ));
      allow delete: if isAdmin();
    }

    // ── Public content (read by everyone, written by admin) ─
    match /daily_live_tests/{dateId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /custom_passages/{passageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Paid passages (read only by admin, or by a subscriber whose plan is still
    //    valid and covers this passage; write and list only by admin) ─
    match /paid_passages/{passageId} {
      allow get: if signedIn() && (
        isAdmin() ||
        canReadPaidPassage(
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data,
          resource.data
        )
      );
      allow list, write: if isAdmin();
    }

    // ── Collection group: Leaderboard query (read-only for authenticated candidates) ─
    match /{path=**}/test_attempts/{testId} {
      allow read: if signedIn();
    }
  }
}

